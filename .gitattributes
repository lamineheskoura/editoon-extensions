# catalog.json is regenerated by tools/rebuild_catalog.ps1 which always writes
# LF endings; pin it so local Windows checkouts (core.autocrlf=true) never
# produce spurious diffs that make the CI determinism check fail.
catalog.json text eol=lf
*.json text eol=lf
*.lua text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
